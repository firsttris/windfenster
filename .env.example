# Development settings. `pnpm dev` copies this to `.env` on the first run; the server reads
# `.env` itself, so `cargo run -p windfenster` works too. Variables set in the environment win.

WF_DATA_DIR=./.data
WF_LISTEN=127.0.0.1:8080

# While no SPA is built into the binary, :8080 redirects here (Vite dev server).
WF_DEV_UI=http://localhost:5173

# Optional: Open-Meteo key (customer API) or an own instance.
# OPEN_METEO_API_KEY=
# OPEN_METEO_BASE_URL=http://localhost:8081
# Fewer models while developing saves calls, e.g.:
# WF_MODELS=icon_d2,ecmwf_ifs025

RUST_LOG=info,sqlx=warn
