// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what Windfenster builds on, plus the "Dependency Dashboard" issue listing what is open. Their own
// pull requests: MapLibre (the map, with the wind field and particles drawn as its custom layers),
// the grib crate (every DWD and ECMWF model field is decoded with it), PMTiles (the basemap and
// relief are cut, written and read in that format), Bun (image and package.json) and the cargo-chef
// of the image. The data sources themselves (Open-Meteo, DWD, ECMWF, Protomaps builds, Mapterhorn)
// have no pinned version: the server looks for the newest run or build at runtime. Rust
// (rust:1-trixie, dtolnay stable) and Debian float on purpose.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  customManagers: [
    {
      // `cargo install cargo-chef --version x.y.z` in the Dockerfile
      customType: "regex",
      managerFilePatterns: ["/^Dockerfile$/"],
      matchStrings: ["cargo install cargo-chef --version (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "cargo-chef",
      datasourceTemplate: "crate",
    },
  ],
  packageRules: [
    {
      // Rust and Debian float on purpose (rust:1-trixie, debian:trixie-slim). Windfenster's own
      // image moves with its releases.
      matchPackageNames: ["rust", "debian", "docker.io/tristanteu/**", "tristanteu/**"],
      enabled: false,
    },
    {
      matchManagers: ["npm"],
      matchPackageNames: ["maplibre-gl"],
      enabled: true,
      groupName: "MapLibre",
      sourceUrl: "https://github.com/maplibre/maplibre-gl-js",
      prBodyNotes: [
        "The wind field and the particles are custom WebGL2 layers inside MapLibre (docs/wind-map.md), the basemap a style of Windfenster's own (docs/basemap.md). Before merging: read MapLibre's CHANGELOG for changes to custom layers, `addProtocol`, styles and glyphs; `bun run typecheck`, `bun run test` and `bun run e2e` (the map shaders) must be green; look at the map in light and dark after the screenshots workflow ran on main.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchManagers: ["cargo"],
      matchPackageNames: ["grib"],
      enabled: true,
      groupName: "GRIB decoding",
      sourceUrl: "https://github.com/noritada/grib-rs",
      commitMessageTopic: "grib",
      prBodyNotes: [
        "Every model field from the DWD (ICON, ICON-D2, CCSDS and PNG packing) and ECMWF open data is decoded with it, pure Rust only (`ccsds-unpack-with-rust-aec`, no OpenJPEG or libaec). Before merging: read the CHANGELOG for changes to the template and unpacking APIs and to the features in Cargo.toml; `cargo test --workspace` runs the wf-map pipelines (tests/icon_d2.rs, icon_global.rs, ecmwf.rs) against stand-ins with generated GRIB2 messages, so also let a server with this branch decode one real run of each model.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // The format of basemap.pmtiles and terrain.pmtiles: written by the server (wf-map), read by
      // the SPA through the pmtiles protocol of MapLibre
      matchManagers: ["cargo", "npm"],
      matchPackageNames: ["pmtiles"],
      enabled: true,
      groupName: "PMTiles",
      sourceUrl: "https://github.com/protomaps/PMTiles",
      prBodyNotes: [
        "The server cuts and writes the basemap and relief with the crate (wf-map, `basemap/writer.rs` follows spec v3 itself), the SPA reads them with the npm package. Before merging: `cargo test --workspace` (the map API and the writer tests) and `bun run e2e`; a new spec version means existing `basemap.pmtiles` files on servers must still be readable.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Bun of the image's web stage and of package.json, in one PR, majors too. Renovate's bun
      // manager reads "packageManager": "bun@x.y.z" itself, as the npm package `bun` (no regex
      // manager needed).
      matchPackageNames: ["docker.io/oven/bun", "oven/bun", "bun"],
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "The image's `web` stage (`oven/bun:<version>-slim`) and `packageManager` in `package.json` (CI takes its version from there: setup-bun, and npm in the Playwright image) move together. Bun installs the packages and runs the scripts; Vite runs on Node where that is installed (CI, development) and on Bun in the image's web stage. Run `bun install` in case `bun.lock` changes. CI's docker job builds and starts the image.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchPackageNames: ["cargo-chef"],
      sourceUrl: "https://github.com/LukeMathWalker/cargo-chef",
      commitMessageTopic: "cargo-chef",
    },
    {
      // e2e-server.yml builds the binary on ubuntu-24.04 on purpose: it must start in the
      // Playwright image (Ubuntu noble), whose glibc is older than a newer runner's (glibc 2.43).
      // Move it only together with the Playwright image's Ubuntu.
      // (A regex: the runners' docker versioning knows no ranges.)
      matchDatasources: ["github-runners"],
      matchPackageNames: ["ubuntu"],
      allowedVersions: "/^2[0-4]\\.04$/",
    },
  ],
}
