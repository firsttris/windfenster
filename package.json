{
  "name": "windfenster",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @windfenster/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bindings": "cargo test --workspace export_bindings",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
