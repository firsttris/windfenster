{
  "name": "windfenster",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "[ -f .env ] || { cp .env.example .env && echo '.env created from .env.example'; }; printf '\\n  Windfenster: http://localhost:5173\\n\\n' && bun run --parallel dev:server dev:web",
    "dev:server": "cargo run -p windfenster",
    "dev:web": "bun run --cwd web dev",
    "build": "bun run --filter @windfenster/web build",
    "test": "bun run --filter @windfenster/web test",
    "typecheck": "bun run --filter @windfenster/web typecheck",
    "bindings": "cargo test --workspace export_bindings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "bun run --filter @windfenster/web e2e",
    "screenshots": "bun run --filter @windfenster/web screenshots"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
