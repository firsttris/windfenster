{
  "name": "windfenster",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --filter @windfenster/web build",
    "test": "bun test ./scripts && bun run --filter @windfenster/web test",
    "typecheck": "bun run --filter @windfenster/web typecheck",
    "bindings": "cargo test --workspace export_bindings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "bun run --filter @windfenster/web e2e",
    "screenshots": "bun run --filter @windfenster/web screenshots"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
