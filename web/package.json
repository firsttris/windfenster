{
  "name": "@windfenster/web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --silent",
    "dev": "bun run i18n && vite",
    "build": "bun run i18n && tsc -p . && vite build && bun scripts/precompress.mjs",
    "typecheck": "bun run i18n && tsc -p .",
    "test": "bun run i18n && vitest run",
    "e2e": "bun run i18n && bun --bun playwright test --grep-invert @screenshots",
    "screenshots": "bun run i18n && bun --bun playwright test --project=app --grep @screenshots"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.13.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.5.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
