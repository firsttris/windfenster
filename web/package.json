{
  "name": "@windfenster/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --silent",
    "dev": "pnpm i18n && vite",
    "build": "pnpm i18n && tsc -p . && vite build",
    "typecheck": "pnpm i18n && tsc -p .",
    "test": "pnpm i18n && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
